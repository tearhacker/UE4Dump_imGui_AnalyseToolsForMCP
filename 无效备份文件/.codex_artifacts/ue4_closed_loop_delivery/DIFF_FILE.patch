+std::vector<uint8_t> ParseHexQuery(const std::string &raw)
+{
+    std::vector<uint8_t> bytes;
+    if (!HexToBytes(raw, bytes) || bytes.empty())
+        throw HandlerError(Err::kBadArgs, "HEX query 必须包含有效的十六进制字节");
