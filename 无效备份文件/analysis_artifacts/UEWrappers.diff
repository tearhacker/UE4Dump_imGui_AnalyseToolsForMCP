> int32_t UE_UObjectArray::GetNumElements() const
> {
>     if (!UEWrappers::GUVars || UEWrappers::GUVars->GetObjObjectsPtr() == 0 ||
>         !UEWrappers::GetOffsets())
>         return 0;
> 
>     const int32_t count = vm_rpm_ptr<int32_t>((void *)(UEWrappers::GUVars->GetObjObjectsPtr() +
>         UEWrappers::GetOffsets()->TUObjectArray.NumElements));
>     return (count >= 0 && count <= 5000000) ? count : 0;
